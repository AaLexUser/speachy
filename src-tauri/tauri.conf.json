{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Speachy",
  "identifier": "com.speachy.app",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "macOSPrivateApi": true,
    "withGlobalTauri": true,
    "windows": [],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "app",
      "dmg"
    ],
    "category": "Productivity",
    "shortDescription": "Read any selected text aloud with local TTS models",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "minimumSystemVersion": "11.0",
      "signingIdentity": "-"
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDBFODQ0NDhGOThCNUU1QzYKUldURzViV1lqMFNFRHJ6RWpNLzlKMlpFNU9LVlpXcCtHQzdCcEd4dXg2ODlqeWVzN081eG5GRkkK",
      "endpoints": [
        "https://github.com/AaLexUser/speachy/releases/latest/download/latest.json"
      ]
    }
  }
}
